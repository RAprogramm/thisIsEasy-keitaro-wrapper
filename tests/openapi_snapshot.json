{
  "components": {
    "schemas": {
      "CampaignCreate": {
        "properties": {
          "domain_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Id"
          },
          "geo": {
            "description": "ISO country code, e.g. US",
            "maxLength": 2,
            "minLength": 2,
            "title": "Geo",
            "type": "string"
          },
          "group_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Id"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "offer_id": {
            "exclusiveMinimum": 0.0,
            "title": "Offer Id",
            "type": "integer"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          }
        },
        "required": [
          "name",
          "geo",
          "offer_id"
        ],
        "title": "CampaignCreate",
        "type": "object"
      },
      "CampaignCreated": {
        "description": "Confirmation that a campaign now exists in Keitaro.",
        "properties": {
          "domain_id": {
            "title": "Domain Id",
            "type": "integer"
          },
          "group_id": {
            "title": "Group Id",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "domain_id",
          "group_id",
          "source_id"
        ],
        "title": "CampaignCreated",
        "type": "object"
      },
      "CampaignListItem": {
        "description": "A campaign created through the creator, as listed for the editor.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "geo": {
            "title": "Geo",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "geo",
          "created_at"
        ],
        "title": "CampaignListItem",
        "type": "object"
      },
      "CampaignView": {
        "description": "Full campaign payload returned by the editor.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "keitaro_url": {
            "default": "",
            "title": "Keitaro Url",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stats_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stats Error"
          },
          "streams": {
            "items": {
              "$ref": "#/components/schemas/StreamView"
            },
            "title": "Streams",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "streams"
        ],
        "title": "CampaignView",
        "type": "object"
      },
      "DictItem": {
        "description": "One entry of a Keitaro dictionary (domain, group, source, offer).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "DictItem",
        "type": "object"
      },
      "Dictionaries": {
        "description": "Dictionary payloads that feed the creation form.",
        "properties": {
          "domains": {
            "items": {
              "$ref": "#/components/schemas/DictItem"
            },
            "title": "Domains",
            "type": "array"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/DictItem"
            },
            "title": "Groups",
            "type": "array"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/DictItem"
            },
            "title": "Offers",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/DictItem"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "domains",
          "groups",
          "sources",
          "offers"
        ],
        "title": "Dictionaries",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OfferAdd": {
        "properties": {
          "offer_id": {
            "exclusiveMinimum": 0.0,
            "title": "Offer Id",
            "type": "integer"
          },
          "stream_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stream Id"
          }
        },
        "required": [
          "offer_id"
        ],
        "title": "OfferAdd",
        "type": "object"
      },
      "OfferStats": {
        "description": "Per-offer numbers exactly as Keitaro reports them.",
        "properties": {
          "clicks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clicks"
          },
          "conversions": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversions"
          },
          "cost": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          },
          "profit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profit"
          },
          "revenue": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revenue"
          },
          "unique_clicks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unique Clicks"
          }
        },
        "required": [
          "clicks",
          "unique_clicks",
          "conversions",
          "revenue",
          "cost",
          "profit"
        ],
        "title": "OfferStats",
        "type": "object"
      },
      "OfferView": {
        "description": "An offer inside a stream, with its share and statistics.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "offer_id": {
            "title": "Offer Id",
            "type": "integer"
          },
          "pinned": {
            "default": false,
            "title": "Pinned",
            "type": "boolean"
          },
          "share": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "stats": {
            "$ref": "#/components/schemas/OfferStats"
          },
          "status": {
            "default": "active",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "offer_id",
          "name",
          "share",
          "state",
          "stats"
        ],
        "title": "OfferView",
        "type": "object"
      },
      "StreamView": {
        "description": "A campaign stream with its offers.",
        "properties": {
          "dirty": {
            "default": false,
            "title": "Dirty",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/OfferView"
            },
            "title": "Offers",
            "type": "array"
          },
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema"
          }
        },
        "required": [
          "id",
          "name",
          "offers"
        ],
        "title": "StreamView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Keitaro wrapper",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/campaigns": {
      "get": {
        "operationId": "list_campaigns_api_campaigns_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CampaignListItem"
                  },
                  "title": "Response List Campaigns Api Campaigns Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Campaigns",
        "tags": [
          "creator"
        ]
      },
      "post": {
        "operationId": "create_campaign_api_campaigns_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CampaignCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Campaign",
        "tags": [
          "creator"
        ]
      }
    },
    "/api/campaigns/search": {
      "get": {
        "description": "Search Keitaro campaigns by name or exact ID for the editor picker.\n\nThe full list is cached for a few seconds so a burst of keystrokes\nproduces a single upstream request.",
        "operationId": "search_campaigns_api_campaigns_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 100,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DictItem"
                  },
                  "title": "Response Search Campaigns Api Campaigns Search Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Campaigns",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}": {
      "get": {
        "description": "Full campaign payload: streams, offers, statistics and dirty flags.",
        "operationId": "get_campaign_endpoint_api_campaigns__campaign_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Campaign Endpoint",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/cancel": {
      "post": {
        "description": "Discard staged changes: additions vanish, removals revert to published.",
        "operationId": "cancel_stream_api_campaigns__campaign_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "stream_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stream Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Stream",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/offers": {
      "post": {
        "description": "Stage an offer addition to a stream; shares are rebalanced, Keitaro untouched.",
        "operationId": "add_offer_api_campaigns__campaign_id__offers_post",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferAdd"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Offer",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/offers/{offer_id}": {
      "delete": {
        "description": "Stage an offer removal: share 0, others rebalanced, archived on push.",
        "operationId": "remove_offer_api_campaigns__campaign_id__offers__offer_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "offer_id",
            "required": true,
            "schema": {
              "title": "Offer Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "stream_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stream Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove Offer",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/offers/{offer_id}/pin": {
      "post": {
        "description": "Pin or unpin an offer's share; pinned shares survive rebalancing.",
        "operationId": "pin_offer_api_campaigns__campaign_id__offers__offer_id__pin_post",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "offer_id",
            "required": true,
            "schema": {
              "title": "Offer Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "stream_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stream Id"
            }
          },
          {
            "in": "query",
            "name": "pinned",
            "required": false,
            "schema": {
              "default": true,
              "title": "Pinned",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pin Offer",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/offers/{offer_id}/restore": {
      "post": {
        "description": "Bring an archived offer back into the stream as a staged addition.",
        "operationId": "restore_offer_api_campaigns__campaign_id__offers__offer_id__restore_post",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "offer_id",
            "required": true,
            "schema": {
              "title": "Offer Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "stream_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stream Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Restore Offer",
        "tags": [
